# Version the reconstruction, its assets, build files and public documentation.
/*
!/.gitignore
!/README.md
!/BUILDING.md
!/LICENSE
!/LEGAL.md
!/ASSETS.md
!/CMakeLists.txt
!/CMakePresets.json
!/build.ps1
!/src/
!/assets/
!/third_party/
/third_party/*
!/third_party/licenses/

# Never version generated outputs, caches or executable game data.
**/__pycache__/
**/*.pyc
**/*.o
**/*.exe
**/*.dll
**/*.bmp
**/*.wav
**/*.CMF
**/*.HI
.vs/
.vscode/
.idea/
*.user
*.swp
.DS_Store
Thumbs.db

# The editable game assets are versioned, whatever their file type.
!/assets/**
